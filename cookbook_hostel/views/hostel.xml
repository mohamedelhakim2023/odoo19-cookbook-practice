<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_hostel_list" model="ir.ui.view">
        <field name="name">cookbook.hostel.list</field>
        <field name="model">cookbook.hostel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="hostel_code"/>
                <field name="state_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_hostel_form" model="ir.ui.view">
        <field name="name">cookbook.hostel.form</field>
        <field name="model">cookbook.hostel</field>
        <field name="arch" type="xml">
            <form string="Hostel">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="hostel_code"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="state_id"/>
                        </group>
                        <group string="Hostel Details">
                            <field name="hostel_floors"/>
                            <field name="type"/>
                            <field name="active"/>
                            <field name="other_info"/>
                            <field name="opened_on"/>
                            <field name="inspection_at"/>
                            <field name="hostel_rating"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_hostel_search" model="ir.ui.view">
        <field name="name">cookbook.hostel.search</field>
        <field name="model">cookbook.hostel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="hostel_code"/>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_hostel" model="ir.actions.act_window">
        <field name="name">Hostels</field>
        <field name="res_model">cookbook.hostel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hostel_search"/>
    </record>

    <!-- Menus -->
    <menuitem id="hostel_main_menu"
              name="Hostel Training"
              sequence="10"/>

    <menuitem id="hostel_menu"
              name="Hostels"
              parent="hostel_main_menu"
              action="action_hostel"
              sequence="10"/>

</odoo>